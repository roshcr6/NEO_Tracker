# Environment Variables for Production
# Copy this file to .env and fill in your values

# Django Settings
SECRET_KEY=your-secret-key-here-generate-a-new-one
DEBUG=False
ALLOWED_HOSTS=your-backend-domain.com,www.your-backend-domain.com

# Frontend URL (for CORS)
FRONTEND_URL=https://your-frontend.vercel.app

# NASA API - Get your free API key at: https://api.nasa.gov
# IMPORTANT: Keep this secret! Never commit your actual .env file to git
NASA_API_KEY=your-nasa-api-key-here

# Database (Optional - for PostgreSQL on Render)
# DATABASE_URL=postgresql://user:password@host:port/database
